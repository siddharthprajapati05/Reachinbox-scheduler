# Copy this file to backend/.env and fill in the empty values.
# NEVER commit the real .env file.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ---------- Infrastructure (matches docker-compose.yml, no change needed) ----------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ---------- Secrets YOU generate (run: openssl rand -hex 32) ----------
SESSION_SECRET=
# Must be exactly 64 hex characters (32 bytes). Encrypts SMTP passwords and Slack tokens in the database.
ENCRYPTION_KEY=

# ---------- Google OAuth (required) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Slack OAuth (optional: the app runs without it, but real notifications need it) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a Redirect URL in your Slack app settings.
# If Slack refuses http://localhost, use an https tunnel (ngrok / cloudflared) and put that URL here.
SLACK_REDIRECT_URL=http://localhost:4000/api/slack/callback

# ---------- Bull Board access ----------
# Comma-separated Google account emails allowed to open /admin/queues (use your own login email).
ADMIN_EMAILS=

# ---------- Sending limits ----------
# How many emails one worker process handles at the same time
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (applies across all workers)
MIN_DELAY_MS=2000
# Maximum emails per rolling hour for each sender. The compose form may go lower, never higher.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
